<%@ page pageEncoding="UTF-8" %>
<%-- Navegación lateral compartida, con enlaces a los módulos del sistema. --%>
<%-- Normaliza el rol de la sesión para que mayúsculas y tildes no cambien los permisos del menú. --%>
<% String rolMenu = java.text.Normalizer.normalize(String.valueOf(session.getAttribute("rol")), java.text.Normalizer.Form.NFD)
        .replaceAll("\\p{M}", "").toLowerCase(java.util.Locale.ROOT); %>
<%-- Identifica perfiles que pueden administrar medicamentos, compras, reportes y trazabilidad. --%>
<% boolean gestionCompletaMenu = rolMenu.equals("admin") || rolMenu.equals("administrador") || rolMenu.equals("farmaceutico"); %>
<%-- La administración de cuentas se reserva a Admin y Administrador, no a Farmacéutico. --%>
<% boolean administradorMenu = rolMenu.equals("admin") || rolMenu.equals("administrador"); %>
<%-- Permite consultar el catálogo a los perfiles que necesitan revisar existencias para vender. --%>
<% boolean puedeVerInventarioMenu = gestionCompletaMenu || rolMenu.equals("usuario") || rolMenu.equals("cajero") || rolMenu.equals("vendedor"); %>
<%-- Permite mostrar el acceso a ventas a administradores, usuarios de caja y vendedores. --%>
<% boolean puedeVenderMenu = gestionCompletaMenu || rolMenu.equals("usuario") || rolMenu.equals("cajero") || rolMenu.equals("vendedor"); %>
<aside class="sidebar" aria-label="Navegación principal">
    <div class="side-brand">✚ Farmacia</div>
    <nav class="side-nav" aria-label="Secciones">
    <a class="nav-link ${activePage eq 'panel' ? 'active' : ''}" aria-current="${activePage eq 'panel' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/panel.jsp"><span class="nav-icon" aria-hidden="true">▦</span>Inicio</a>
    <% if (puedeVerInventarioMenu) { %>
    <a class="nav-link ${activePage eq 'medicamentos' ? 'active' : ''}" aria-current="${activePage eq 'medicamentos' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/medicamentos.jsp"><span class="nav-icon" aria-hidden="true">◈</span>Medicamentos</a>
    <% } if (puedeVenderMenu) { %>
    <a class="nav-link ${activePage eq 'ventas' ? 'active' : ''}" aria-current="${activePage eq 'ventas' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/ventas.jsp"><span class="nav-icon" aria-hidden="true">🛒</span>Ventas</a>
    <% } if (gestionCompletaMenu) { %>
    <a class="nav-link ${activePage eq 'compras' ? 'active' : ''}" aria-current="${activePage eq 'compras' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/compras.jsp"><span class="nav-icon" aria-hidden="true">▤</span>Compras</a>
    <a class="nav-link ${activePage eq 'reportes' ? 'active' : ''}" aria-current="${activePage eq 'reportes' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/reportes.jsp"><span class="nav-icon" aria-hidden="true">▥</span>Reportes</a>
    <a class="nav-link ${activePage eq 'trazabilidad' ? 'active' : ''}" aria-current="${activePage eq 'trazabilidad' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/trazabilidad.jsp"><span class="nav-icon" aria-hidden="true">↔</span>Movimientos de inventario</a>
    <% } %>
    <%-- Muestra el acceso al listado de cuentas únicamente a perfiles administradores. --%>
    <% if (administradorMenu) { %><a class="nav-link ${activePage eq 'catalogo' ? 'active' : ''}" aria-current="${activePage eq 'catalogo' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/CatalogoInvimaServlet"><span class="nav-icon" aria-hidden="true">▦</span>Catálogo INVIMA</a><a class="nav-link ${activePage eq 'usuarios' ? 'active' : ''}" aria-current="${activePage eq 'usuarios' ? 'page' : 'false'}" href="${pageContext.request.contextPath}/usuarios.jsp"><span class="nav-icon" aria-hidden="true">♙</span>Usuarios</a><% } %>
    </nav>
    <a class="nav-link logout" href="${pageContext.request.contextPath}/LogoutServlet">Cerrar sesión</a>
</aside>


