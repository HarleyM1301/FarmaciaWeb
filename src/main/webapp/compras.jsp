<%-- Importa una factura y prepara una recepción técnica con varias líneas y lotes. --%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ page import="java.util.*,java.sql.SQLException,com.farmacia.dao.MedicamentoDAO,com.farmacia.dao.MovimientoDAO,com.farmacia.modelo.medicamento,com.farmacia.util.HtmlUtil" %>
<%
// Carga el historial de facturas y los productos que alimentan la recepción técnica.
request.setAttribute("activePage", "compras");
List<Map<String,Object>> compras = new ArrayList<>();
List<medicamento> medicamentos = new MedicamentoDAO().listar();
try { compras = new MovimientoDAO().listar(false); } catch (SQLException e) { application.log("No se pudieron consultar las compras", e); request.setAttribute("errorBD", true); }
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Compras | Farmacia</title><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/app.css"></head>
<body><div class="shell"><%@ include file="/WEB-INF/partials/topbar.jspf" %><%@ include file="/WEB-INF/partials/sidebar.jspf" %><main class="main">
<div class="page-heading"><div><h1>Compras y recepción técnica</h1><p>Carga la factura, revisa sus productos y registra las existencias por lote.</p></div><button id="abrirRecepcion" class="btn" type="button">＋ Recibir factura</button></div>
<section id="borradoresRecepcion" class="card" hidden><div class="dashboard-card-heading"><div><h2>Recepciones pendientes</h2><p class="muted">Se guardan en este navegador para que puedas retomarlas antes de confirmar.</p></div></div><div id="listaBorradoresRecepcion" class="borradores-lista"></div></section>
<%-- Muestra mensajes de resultado para guardado, edición, eliminación o error de operación. --%>
<% if ("ok".equals(request.getParameter("estado"))) { %><div class="notice">Factura guardada. Las cantidades recibidas ya están en el inventario.</div><% } %>
<% if ("editada".equals(request.getParameter("estado"))) { %><div class="notice">Factura y líneas actualizadas; el inventario se ajustó según las cantidades nuevas.</div><% } %>
<% if ("eliminada".equals(request.getParameter("estado"))) { %><div class="notice">Factura eliminada y existencias revertidas.</div><% } %>
<% if ("error_edicion".equals(request.getParameter("estado"))) { %><div class="notice error">No se pudo modificar o eliminar la factura. Si ya se vendieron unidades, el sistema impide anularla cuando no hay stock suficiente.</div><% } %>
<% if ("error".equals(request.getParameter("estado")) || Boolean.TRUE.equals(request.getAttribute("errorBD"))) { %><div class="notice error">No se pudo completar la recepción. Revisa el registro de Tomcat para ver el detalle.</div><% } %>
<%-- Historial de facturas con búsqueda, descarga de adjuntos, edición y anulación segura. --%>
<section class="card"><div class="toolbar"><label class="search"><input id="buscar" type="search" placeholder="Buscar factura, fecha o proveedor" aria-label="Buscar compra"></label><span class="muted"><%= compras.size() %> facturas</span></div>
<div class="table-wrap"><table id="tabla"><thead><tr><th>Factura</th><th>Fecha</th><th>Proveedor</th><th>Productos</th><th>Unidades</th><th>Total</th><th>Archivo</th><th>Acciones</th></tr></thead><tbody>
<% if (compras.isEmpty()) { %><tr><td colspan="8" class="empty">Aún no hay compras registradas.</td></tr><% } for (Map<String,Object> c : compras) { %>
<tr><td><%= HtmlUtil.escapar(c.get("numeroFactura")) %></td><td><%= HtmlUtil.escapar(c.get("fecha")) %></td><td><%= HtmlUtil.escapar(c.get("tercero")) %></td><td><%= HtmlUtil.escapar(c.get("medicamento")) %></td><td><%= c.get("cantidad") %></td><td>$<%= String.format(java.util.Locale.forLanguageTag("es-CO"), "%,.0f", ((java.math.BigDecimal)c.get("total")).doubleValue()) %></td><td><% if (c.get("archivoFactura") != null) { %><a class="back-link" href="<%= request.getContextPath() %>/FacturaCompraServlet?id=<%= c.get("id") %>">Descargar</a><% } else { %><span class="muted">—</span><% } %></td><td><div class="inline-actions"><a class="btn secondary small" href="<%= request.getContextPath() %>/compra-detalle.jsp?id=<%= c.get("id") %>">Editar</a><form action="<%= request.getContextPath() %>/CompraServlet" method="post" onsubmit="return confirm('¿Eliminar esta factura y revertir las unidades al inventario? Si parte del stock ya se vendió, la operación se cancelará.')"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="<%= c.get("id") %>"><button class="btn danger small" type="submit">Eliminar</button></form></div></td></tr>
<% } %></tbody></table></div></section><div class="form-actions"><a class="btn secondary" href="<%= request.getContextPath() %>/panel.jsp">Volver al Dashboard</a></div>
</main></div>

<%-- Ventana de recepción: el archivo se conserva como adjunto y sus líneas quedan editables antes de confirmar. --%>
<div id="modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="titulo"><section class="modal-box" style="width:min(1100px,96vw)"><div class="modal-head"><h2 id="titulo">Cargar factura y hacer recepción técnica</h2><button class="close" type="button" onclick="cerrar()" aria-label="Cerrar">×</button></div>
<form id="formCompra" data-usuario-id="<%= session.getAttribute("idUsuario") %>" action="<%= request.getContextPath() %>/MovimientoServlet" method="post" enctype="multipart/form-data"><input type="hidden" name="tipo" value="compra">
<input type="hidden" id="diferenciaConfirmada" name="diferenciaConfirmada" value="false">
<div class="form-grid">
<div class="field"><label for="factura">Archivo de factura</label><input id="factura" name="factura" type="file" accept=".xml,.zip,.csv,.txt,.pdf,.xlsx,.xls,.jpg,.jpeg,.png"><small>XML/ZIP, CSV, PDF y fotos se leen localmente. Para Excel, pega la tabla. También puedes escanear el código del empaque.</small></div>
<div class="field"><label for="proveedor">Proveedor *</label><input id="proveedor" name="proveedor" maxlength="100" required></div>
<div class="field"><label for="numeroFactura">Número de factura *</label><input id="numeroFactura" name="numeroFactura" maxlength="60" required></div>
<div class="field"><label for="fecha">Fecha de factura *</label><input id="fecha" name="fecha" type="date" required></div>
<div class="field"><label for="totalFactura">Total según factura (opcional)</label><input id="totalFactura" name="totalFactura" type="number" min="0" step="0.01" placeholder="Se calcula desde los productos"></div>
</div>
<div id="importStatus" class="notice" hidden aria-live="polite"></div>
<section class="card" style="margin-top:12px;padding:12px"><strong>Carga varios productos de una vez</strong><p class="muted" style="margin:5px 0 8px">Copia Producto, cajas/paquetes, costo por caja/paquete y, si aplica, lote, vencimiento, precio público y grupo farmacológico.</p><textarea id="productosPegados" rows="3" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px" placeholder="Producto[TAB]Cajas/paquetes[TAB]Costo por caja/paquete[TAB]Lote[TAB]Vencimiento[TAB]Precio público[TAB]Grupo farmacológico"></textarea><div class="form-actions"><button class="btn secondary" type="button" onclick="importarTablaPegada()">＋ Agregar filas copiadas</button></div></section>
<section class="card" style="margin-top:12px;padding:12px"><label for="margenSugerido"><strong>Margen para sugerir precio público (%)</strong></label> <input id="margenSugerido" type="number" min="0" max="95" step="1" value="30" style="width:100px" oninput="actualizarSugerenciasPrecio()"> <span class="muted">Se calcula sobre el costo por unidad base. Solo se aplica si marcas actualizar el precio.</span></section>
<section id="ocrReview" class="card" style="margin-top:12px" hidden><label for="textoOCR"><strong>Texto reconocido de la imagen</strong></label><p class="muted">La lectura automática puede confundir caracteres y valores. El sistema selecciona coincidencias claras del catálogo; si no puede separar cantidad y costo con seguridad, deja esos campos vacíos para que los completes. Corrige el texto si hace falta y vuelve a generar los productos. Revisa cada medicamento antes de guardar.</p><textarea id="textoOCR" rows="7" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px"></textarea><button class="btn secondary" type="button" onclick="importarTextoOCR()">Volver a detectar productos</button></section>
<section class="card" style="margin-top:16px;padding:16px"><div class="page-heading" style="margin:0 0 12px"><div><h3 style="margin:0">Productos de la factura</h3><p class="muted" style="margin:4px 0 0">Una fila por producto facturado. Marca los medicamentos que deben registrarse con uno o varios lotes.</p></div><button class="btn secondary" type="button" onclick="agregarLinea()">＋ Agregar producto</button></div>
<div class="table-wrap"><table><thead><tr><th>Medicamento identificado</th><th>Cantidad de cajas/paquetes de la factura</th><th>Costo por caja/paquete</th><th>Unidad y contenido</th><th>Recepción técnica</th><th></th></tr></thead><tbody id="lineas"></tbody></table></div>
<p class="muted">Escribe la cantidad tal como aparece en la factura (cajas o paquetes). El sistema usa el contenido guardado para cada presentación y muestra cuántas unidades ingresarán al inventario. Si el tamaño cambia (por ejemplo, caja x10 o x20), debe tener una ficha de producto distinta.</p></section>
<section class="card" style="margin-top:12px;padding:12px"><strong>Revisión de importes</strong><p id="resumenImportes" class="muted" aria-live="polite">Completa cantidades y costos para calcular el total de las líneas.</p></section>
<template id="plantillaLinea"><tr class="linea-compra">
<td><select class="producto-select" required onchange="actualizarProductoNuevo(this)"><option value="">Selecciona un producto</option>
<% for (medicamento m : medicamentos) { %><option value="<%= m.getIdMedicamento() %>" data-catalogo-id="<%= m.getCatalogoMedicamentoId() == null ? "" : m.getCatalogoMedicamentoId() %>" data-nombre="<%= HtmlUtil.escapar(m.getNombre()) %>" data-lote="<%= HtmlUtil.escapar(m.getLote()) %>" data-unidad="<%= HtmlUtil.escapar(m.getUnidadBase()) %>" data-factor="<%= m.getUnidadesPorPresentacion() %>" data-blister-factor="<%= m.getUnidadesPorBlister() %>" data-precio="<%= m.getPrecio() %>"><%= HtmlUtil.escapar(m.getNombre()) %> · lote <%= HtmlUtil.escapar(m.getLote()) %> · stock <%= HtmlUtil.escapar(m.getStockDesglosado()) %></option><% } %>
<option value="nuevo">＋ Crear producto nuevo</option></select><input class="nombre-nuevo" maxlength="100" placeholder="Nombre del producto nuevo" hidden><div class="catalogo-invima-wrap" hidden><button class="btn secondary small" type="button" onclick="buscarCatalogoInvima(this)">Buscar coincidencia en INVIMA</button><div class="catalogo-invima-resultados" aria-live="polite"></div><input class="catalogo-invima-id" type="hidden"><input class="registro-invima" type="hidden"></div><label class="codigo-barras-wrap">Código de barras recibido<input class="codigo-barras" type="text" inputmode="numeric" autocomplete="off" placeholder="EAN/UPC o GS1 · escanea y Enter" maxlength="128" aria-label="Código de barras del medicamento"></label><button class="btn secondary small boton-camara" type="button" onclick="abrirCamaraCodigo(this)" aria-label="Escanear con la cámara">📷 Cámara</button><label class="categoria-nueva-wrap" hidden>Grupo farmacológico<select class="categoria-nueva" maxlength="50" aria-label="Grupo farmacológico"><option value="">Selecciona un grupo</option><%@ include file="/WEB-INF/partials/grupos-farmacologicos.jspf" %></select></label><label class="blister-nuevo-wrap" hidden>Unidades base por blíster<input class="blister-factor-nuevo" type="number" min="0" max="100000" step="1" value="0" oninput="actualizarConversion(this.closest('tr'))"></label><label class="precio-nuevo-wrap" hidden>Precio público por unidad base<input class="precio-venta-nuevo" type="number" min="0.01" step="0.01" placeholder="Precio de venta" oninput="this.dataset.modificado='true';actualizarRevision()"><small class="sugerencia-nueva"></small></label><div class="precio-existente" hidden><label><input class="actualizar-precio" type="checkbox" onchange="alternarPrecio(this)"> Actualizar precio público</label><label>Precio público nuevo<input class="precio-venta-actual" type="number" min="0.01" step="0.01" oninput="actualizarRevision()"></label><small class="sugerencia-precio"></small></div><small class="coincidencia-producto" aria-live="polite"></small></td>
<td><label class="cantidad-presentacion-label">Cajas/paquetes<input class="cantidad-factura" type="number" min="1" step="1" value="1" required oninput="actualizarConversion(this.closest('tr'))"></label></td><td><label class="costo-presentacion-label">Costo por caja/paquete<input class="costo-factura" type="number" min="0" step="0.01" placeholder="0,00" required></label></td>
<td><label>Se controla por<select class="unidad-base" required aria-label="Unidad base" onchange="actualizarConversion(this.closest('tr'))"><option value="unidad">Unidad</option><option value="caja">Caja</option><option value="paquete">Paquete</option><option value="tableta">Tableta/comprimido</option><option value="capsula">Cápsula</option><option value="sobre">Sobre</option><option value="ml">Mililitro (ml)</option><option value="gota">Gota</option><option value="ampolla">Ampolla</option><option value="frasco">Frasco</option></select></label><label class="factor-empaque-label">Cada caja/paquete trae<input class="factor-empaque" type="number" min="1" max="100000" step="1" value="1" required oninput="actualizarConversion(this.closest('tr'))"></label><small class="conversion-preview" aria-live="polite"></small></td>
<td><label><input class="control-lotes" type="checkbox" onchange="alternarLotes(this)"> Asignar lote(s)</label></td>
<td><button class="btn danger small" type="button" onclick="quitarLinea(this)" aria-label="Quitar línea">Quitar</button></td></tr>
<tr class="fila-lotes" hidden><td colspan="6"><strong>Distribución de recepción técnica</strong><div class="lotes-lista"></div><button class="btn secondary small" type="button" onclick="agregarLote(this)">＋ Agregar lote</button></td></tr></template>
<template id="plantillaLote"><div class="lote-detalle" style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:8px;margin:8px 0"><label>Lote<input class="dato-lote" style="width:100%" maxlength="30" placeholder="Número de lote"></label><label>Vencimiento<input class="dato-vencimiento" style="width:100%" type="date"></label><label>Cajas/paquetes de este lote<input class="dato-cantidad-lote" style="width:100%" type="number" min="1" step="1" value="1" required></label><button class="btn danger small" type="button" onclick="this.closest('.lote-detalle').remove()">Quitar</button></div></template>
<div id="lineasSerializadas"></div><input type="hidden" id="borradorId" name="borradorId" value=""><div id="estadoBorrador" class="notice" hidden aria-live="polite"></div>
<div class="form-actions"><button class="btn secondary" type="button" onclick="cerrar()">Cancelar</button><button class="btn" type="submit">Confirmar recepción e ingresar al inventario</button></div>
</form></section></div>
<div id="modalCamaraCodigo" class="modal" role="dialog" aria-modal="true" aria-labelledby="tituloCamaraCodigo"><section class="modal-box"><div class="modal-head"><h2 id="tituloCamaraCodigo">Escanear código de barras</h2><button class="close" type="button" onclick="cerrarCamaraCodigo()" aria-label="Cerrar cámara">×</button></div><video id="videoCamaraCodigo" autoplay playsinline style="width:100%;border-radius:10px;background:#101818"></video><p id="estadoCamaraCodigo" class="muted" aria-live="polite">Centra el código dentro del recuadro.</p></section></div>
<script id="ocr-runtime" data-context="<%= request.getContextPath() %>" src="<%= request.getContextPath() %>/assets/vendor/ocr/tesseract.min.js" defer></script>
<script src="<%= request.getContextPath() %>/assets/js/factura-importador.js"></script>
<script src="<%= request.getContextPath() %>/assets/js/compras.js"></script><script src="<%= request.getContextPath() %>/assets/js/borradores-compra.js"></script></body></html>
